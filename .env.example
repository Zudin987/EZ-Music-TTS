# Discord application/bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Bundled Lavalink is intentionally fixed to 127.0.0.1:2333 with a local-only
# internal password, so there are no user-editable Lavalink connection values.

# Optional Spotify album/playlist mirroring via LavaSrc. Spotify Web API now requires
# a Premium-owned developer app in Development Mode. Single Spotify track links work
# without these credentials through official oEmbed metadata -> YTM/YouTube fallback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=MY

# Optional Gemini AI DJ. Get an API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Player defaults
DEFAULT_VOLUME=80
AUTO_DISCONNECT_MINUTES=10
